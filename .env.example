PORT=3000
HOST=127.0.0.1
AUTHOR_LOGIN=your_moodle_login
AUTHOR_FULL_NAME="Фамилия Имя Отчество"
# Generate independent API tokens with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=
REVIEWER_API_TOKEN=
# Use the restricted todo_app user, not postgres. Copy the pooler host from Supabase Connect.
DATABASE_URL=postgresql://todo_app.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DB_SSL=true
# Optional trusted server CA PEM path; TLS certificate validation is always enabled.
DB_SSL_CA_FILE=certs/supabase-ca.crt
# Only for an SSH tunnel: original database TLS hostname, never a bypass of validation.
DB_SSL_SERVERNAME=
# Used only by db:init, never required by the running application.
DATABASE_ADMIN_URL=
# Used only by the independent database integration test.
REVIEWER_DATABASE_URL=
